{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kabridge",
  "compatibility_date": "2025-09-20",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB", 
      "database_name": "kabridge-production",
      "database_id": "local-dev-placeholder"
    }
  ]
}